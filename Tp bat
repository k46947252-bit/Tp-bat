--==================================================

local function makeDistance(p)

	if p == LP then
		return
	end

	local c = p.Character

	if not c then
		return
	end

	local root = c:FindFirstChild("HumanoidRootPart")

	if not root then
		return
	end

	if distanceObjects[c] then
		distanceObjects[c]:Destroy()
	end

	local bg = Instance.new("BillboardGui")
	bg.Name = "BAT_DISTANCE"
	bg.Size = UDim2.fromOffset(110,30)
	bg.StudsOffset = Vector3.new(0,3.2,0)
	bg.AlwaysOnTop = true
	bg.MaxDistance = 10000
	bg.Enabled = distanceEnabled
	bg.Parent = root

	local text = Instance.new("TextLabel")
	text.Size = UDim2.fromScale(1,1)
	text.BackgroundColor3 = Color3.fromRGB(15,16,21)
	text.BackgroundTransparency = .15
	text.BorderSizePixel = 0
	text.Text = "0 studs"
	text.TextColor3 = Color3.fromRGB(235,240,255)
	text.TextSize = 12
	text.Font = Enum.Font.GothamBold
	text.Parent = bg

	corner(text,7)

	distanceObjects[c] = bg
end

local function updateDistances()

	if not distanceEnabled then
		return
	end

	local myChar = LP.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

	if not myRoot then
		return
	end

	for _,p in ipairs(Players:GetPlayers()) do

		if p ~= LP then

			local c = p.Character
			local r = c and c:FindFirstChild("HumanoidRootPart")

			if c and r then

				if not distanceObjects[c] then
					makeDistance(p)
				end

				local bg = distanceObjects[c]

				if bg then

					local label = bg:FindFirstChildOfClass("TextLabel")

					if label then
						local d = (myRoot.Position-r.Position).Magnitude
						label.Text = math.floor(d+.5).." studs"
					end
				end
			end
		end
	end
end

task.spawn(function()

	while Gui.Parent do
		updateDistances()
		task.wait(.1)
	end
end)

for _,p in ipairs(Players:GetPlayers()) do

	if p ~= LP then

		p.CharacterAdded:Connect(function()
			task.wait(.5)
			makeDistance(p)
		end)

		if p.Character then
			task.spawn(function()
				task.wait(.5)
				makeDistance(p)
			end)
		end
	end
end

Players.PlayerAdded:Connect(function(p)

	if p ~= LP then

		p.CharacterAdded:Connect(function()
			task.wait(.5)
			makeDistance(p)
		end)
	end
end)

Players.PlayerRemoving:Connect(function(p)

	if p.Character and distanceObjects[p.Character] then
		distanceObjects[p.Character]:Destroy()
		distanceObjects[p.Character] = nil
	end
end)

DistanceButton.MouseButton1Click:Connect(function()

	distanceEnabled = not distanceEnabled

